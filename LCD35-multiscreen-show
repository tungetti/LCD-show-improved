#!/bin/bash

rotate_angle=90
if [ $# -eq 1 ]; then
    case "$1" in
        0|90|180|270)
            rotate_angle=$(( (90 + $1) % 360 ))
            ;;
        *)
            echo "Invalid parameter: $1 (expected 0, 90, 180, or 270)"
            exit 1
            ;;
    esac
elif [ $# -gt 1 ]; then
    echo "Too many parameters"
    exit 1
fi

sudo ./system_backup.sh

if [ -f /etc/X11/xorg.conf.d/40-libinput.conf ]; then
    sudo rm -rf /etc/X11/xorg.conf.d/40-libinput.conf
fi
if [ ! -d /etc/X11/xorg.conf.d ]; then
    sudo mkdir -p /etc/X11/xorg.conf.d
fi

source ./system_config.sh

if grep -q "^#dtoverlay=vc4-kms-v3d" ./boot/config.txt.bak; then
    sudo sed -i -e 's/^#dtoverlay=vc4-kms-v3d/dtoverlay=vc4-kms-v3d/' ./boot/config.txt.bak
elif ! grep -q "^dtoverlay=vc4-kms-v3d" ./boot/config.txt.bak; then
    sudo echo "dtoverlay=vc4-kms-v3d" >> ./boot/config.txt.bak
fi

sudo echo "dtparam=i2c_arm=on" >> ./boot/config.txt.bak
sudo echo "dtparam=spi=on" >> ./boot/config.txt.bak
sudo echo "enable_uart=1" >> ./boot/config.txt.bak

if [ -f /boot/firmware/overlays/piscreen.dtbo ] || [ -f /boot/overlays/piscreen.dtbo ]; then
    sudo echo "dtoverlay=piscreen,drm,rotate=$rotate_angle" >> ./boot/config.txt.bak
else
    sudo cp ./usr/tft35a-overlay.dtb /boot/overlays/
    sudo cp ./usr/tft35a-overlay.dtb /boot/overlays/tft35a.dtbo
    sudo echo "dtoverlay=tft35a:rotate=$rotate_angle" >> ./boot/config.txt.bak
fi

sudo cp -rf ./boot/config.txt.bak /boot/config.txt

sudo cp -rf "./usr/99-calibration.conf-35-$rotate_angle" /etc/X11/xorg.conf.d/99-calibration.conf

if [ -f /usr/share/X11/xorg.conf.d/99-fbturbo.conf ]; then
    sudo rm -rf /usr/share/X11/xorg.conf.d/99-fbturbo.conf
fi

sudo mkdir -p /usr/local/bin /etc/xdg/autostart
sudo install -m 755 ./usr/lcd35-multiscreen-daemon.sh /usr/local/bin/lcd35-multiscreen-daemon.sh
sudo cp -rf ./usr/lcd35-multiscreen.desktop /etc/xdg/autostart/lcd35-multiscreen.desktop

if ver_ge "$deb_version" "13.1"; then
    sudo cp -rf ./usr/99-fbturbo-fbcp.conf /usr/share/X11/xorg.conf.d/99-fbturbo.~
    if [ -n "$username" ] && [ -d "/home/$username" ]; then
        sudo cp -rf ./etc/.bash_profile-multiscreen "/home/$username/.bash_profile"
        sudo chown "$username:$username" "/home/$username/.bash_profile"
    fi
fi

if ver_lt "$deb_version" "13.1"; then
    sudo cp ./usr/inittab /etc/
fi

sudo touch ./.have_installed
echo "gpio:resistance:35:90:480:320" > ./.have_installed

# Install xrandr, xinput, and evdev touch driver
version=`uname -v`
input_result=0
version=${version##*(}
version=${version%%-*}
echo $version
if test $version -lt 2017; then
    echo "reboot"
else
    echo "need to update touch and multi-screen configuration"
    sudo apt-get install -y xserver-xorg-input-evdev x11-xserver-utils xinput 2> error_output.txt
    dpkg -l | grep -q xserver-xorg-input-evdev
    if [ $? -ne 0 ]; then
        input_result=1
    fi
    if [ $input_result -eq 1 ]; then
        if [ $hardware_arch -eq 32 ]; then
            sudo dpkg -i -B ./xserver-xorg-input-evdev_1%3a2.10.6-1+b1_armhf.deb 2> error_output.txt
        elif [ $hardware_arch -eq 64 ]; then
            sudo dpkg -i -B ./xserver-xorg-input-evdev_1%3a2.10.6-2_arm64.deb 2> error_output.txt
        fi
    fi
    result=`cat ./error_output.txt`
    echo -e "\033[31m$result\033[0m"
    grep -q "error:" ./error_output.txt && exit
    if [ -f /usr/share/X11/xorg.conf.d/10-evdev.conf ]; then
        sudo cp -rf /usr/share/X11/xorg.conf.d/10-evdev.conf /usr/share/X11/xorg.conf.d/45-evdev.conf
    fi
fi

sudo sync
sudo sync
sleep 1

echo "reboot now"
sudo reboot
