#!/bin/bash
# lcd35-calibrate - on-screen touchscreen calibration for the 3.5" MPI3501 panel
# (ADS7846 resistive touchscreen) on Raspberry Pi OS.
#
# The heavy lifting is done by xinput_calibrator, which must run as the desktop
# session user (root cannot open the X display). The resulting evdev
# calibration is applied live through XInput and persisted to
# /etc/X11/xorg.conf.d/99-calibration.conf so it survives an X restart/reboot.
#
# Environment overrides (mainly for tests):
#   LCD35_CAL_CONF            calibration file (default /etc/X11/xorg.conf.d/99-calibration.conf)
#   LCD35_CAL_DEFAULT         shipped default calibration (default /usr/local/share/lcd35/99-calibration.conf.default)
#   LCD35_NO_APPLY=1          skip all live xinput apply calls (config is still written)
#   LCD35_XINPUT_CALIBRATOR   xinput_calibrator binary name or path
#   LCD35_SESSION_USER        desktop session user
#   LCD35_DISPLAY             X display to use (skips probing)
#   LCD35_DEVICE_ID           XInput device id (skips device lookup)

CONF="${LCD35_CAL_CONF:-/etc/X11/xorg.conf.d/99-calibration.conf}"
DEFAULT_CONF="${LCD35_CAL_DEFAULT:-/usr/local/share/lcd35/99-calibration.conf.default}"
CALIBRATOR="${LCD35_XINPUT_CALIBRATOR:-xinput_calibrator}"
DEVICE_NAME="ADS7846 Touchscreen"
DEFAULT_DEB="/usr/local/share/lcd35/xinput-calibrator.deb"
RESTART_FLAG="/run/lcd35-restart-x"

SESSION_USER=""
SESSION_HOME=""
XAUTH=""
DISPLAY_NUM=""
DEVICE_ID=""

usage() {
    cat <<EOF
Usage: sudo lcd35-calibrate [action] [--restart-x]

Actions:
  --wizard, --calibrate   on-screen 4-cross calibration wizard (default)
  --flip-x                mirror the X axis (swap the 1st/2nd calibration values)
  --flip-y                mirror the Y axis (swap the 3rd/4th calibration values)
  --flip-both             mirror both axes
  --show, --status        print session/display, device, driver, live values and config
  --reset                 restore $DEFAULT_CONF and apply it live
  --restart-x             restart X after applying (only if ~/.bash_profile
                          contains the lcd35-restart-x hook, else reboot is required)
  --help, -h              show this help

Examples:
  sudo lcd35-calibrate                  # calibrate with the on-screen wizard
  sudo lcd35-calibrate --flip-y         # fix a vertically mirrored touchscreen
  sudo lcd35-calibrate --flip-y --restart-x
  sudo lcd35-calibrate --show
EOF
}

die() {
    echo "lcd35-calibrate: $*" >&2
    exit 1
}

warn() {
    echo "lcd35-calibrate: $*" >&2
}

set_action() {
    if [ -n "$ACTION" ] && [ "$ACTION" != "$1" ]; then
        echo "lcd35-calibrate: only one calibration action may be used at a time" >&2
        usage >&2
        exit 1
    fi
    ACTION="$1"
}

resolve_session_user() {
    local user="${LCD35_SESSION_USER:-}"

    if [ -z "$user" ]; then
        user="${SUDO_USER:-}"
        if [ "$user" = "root" ]; then
            user=""
        fi
    fi
    if [ -z "$user" ]; then
        user="$(logname 2>/dev/null | tr -d '\n')"
        if [ "$user" = "root" ]; then
            user=""
        fi
    fi
    if [ -z "$user" ]; then
        user="$(awk -F: '$3==1000 {print $1; exit}' /etc/passwd)"
    fi
    if [ -z "$user" ]; then
        die "could not determine the desktop session user; run this from the desktop session or set LCD35_SESSION_USER"
    fi

    SESSION_USER="$user"
}

resolve_home() {
    SESSION_HOME="$(getent passwd "$SESSION_USER" 2>/dev/null | cut -d: -f6)"
    if [ -z "$SESSION_HOME" ]; then
        die "could not resolve the home directory of user '$SESSION_USER'"
    fi
    XAUTH="$SESSION_HOME/.Xauthority"
}

# Run a command as the desktop session user with DISPLAY/XAUTHORITY set.
# $1 = display, remaining arguments = command
run_as_user() {
    local disp="$1"
    shift

    if [ -n "$XAUTH" ] && [ -f "$XAUTH" ]; then
        if [ "$(id -un 2>/dev/null)" = "$SESSION_USER" ]; then
            env DISPLAY="$disp" XAUTHORITY="$XAUTH" "$@"
        else
            sudo -u "$SESSION_USER" env DISPLAY="$disp" XAUTHORITY="$XAUTH" "$@"
        fi
    else
        if [ "$(id -un 2>/dev/null)" = "$SESSION_USER" ]; then
            env DISPLAY="$disp" "$@"
        else
            sudo -u "$SESSION_USER" env DISPLAY="$disp" "$@"
        fi
    fi
}

as_user() {
    run_as_user "$DISPLAY_NUM" "$@"
}

display_has_lcd() {
    local disp="$1"

    run_as_user "$disp" xrandr --query 2>/dev/null \
        | grep -Eq '^[[:space:]]*(SPI|DPI|DSI|None|Unknown)-[A-Za-z0-9._-]+[[:space:]]+connected'
}

resolve_display() {
    local disp

    if [ -n "${LCD35_DISPLAY:-}" ]; then
        DISPLAY_NUM="$LCD35_DISPLAY"
        return 0
    fi

    for disp in :0 :0.1 :0.2; do
        if display_has_lcd "$disp"; then
            DISPLAY_NUM="$disp"
            echo "Using display $disp (3.5\" LCD output detected)"
            return 0
        fi
    done

    DISPLAY_NUM=":0"
}

# Print the XInput id of the ADS7846 touchscreen, or return 1 if not found.
device_id() {
    local id

    if [ -n "$DEVICE_ID" ]; then
        printf '%s\n' "$DEVICE_ID"
        return 0
    fi
    if [ -n "${LCD35_DEVICE_ID:-}" ]; then
        DEVICE_ID="$LCD35_DEVICE_ID"
        printf '%s\n' "$DEVICE_ID"
        return 0
    fi

    id="$(as_user xinput list --id-only "$DEVICE_NAME" 2>/dev/null | head -n1 | tr -d '[:space:]')"
    case "$id" in
        ''|*[!0-9]*) id="" ;;
    esac
    if [ -z "$id" ]; then
        id="$(as_user xinput list 2>/dev/null \
            | grep -i "ADS7846" \
            | sed -n 's/.*id=\([0-9]*\).*/\1/p' \
            | head -n1)"
    fi
    if [ -z "$id" ]; then
        return 1
    fi

    DEVICE_ID="$id"
    printf '%s\n' "$DEVICE_ID"
}

# Print `xinput list-props` output for the touchscreen, or return 1.
device_props() {
    local id

    id="$(device_id)" || return 1
    as_user xinput list-props "$id" 2>/dev/null
}

# $1 = list-props output, $2 = property name
prop_value() {
    printf '%s\n' "$1" \
        | grep -F "$2" \
        | head -n1 \
        | sed 's/^[^:]*:[[:space:]]*//'
}

valid_calibration() {
    printf '%s\n' "$1" \
        | grep -Eq '^-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+[[:space:]]+-?[0-9]+$'
}

normalize_calibration() {
    printf '%s\n' "$1" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'
}

# $1 = optional calibration file
conf_calibration() {
    local file="${1:-$CONF}"

    [ -f "$file" ] || return 1
    sed -n 's/.*Option[[:space:]]*"Calibration"[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n1
}

# $1 = optional calibration file
conf_swap() {
    local file="${1:-$CONF}"

    [ -f "$file" ] || return 1
    sed -n 's/.*Option[[:space:]]*"SwapAxes"[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n1
}

# Current calibration: live XInput property first, config file second.
current_calibration() {
    local props cal

    props="$(device_props)"
    if [ -n "$props" ]; then
        cal="$(prop_value "$props" "Evdev Axis Calibration" | tr ',' ' ')"
        if valid_calibration "$cal"; then
            normalize_calibration "$cal"
            return 0
        fi
    fi

    cal="$(conf_calibration)"
    if valid_calibration "$cal"; then
        normalize_calibration "$cal"
        return 0
    fi

    return 1
}

current_swap() {
    local props value

    props="$(device_props)"
    if [ -n "$props" ]; then
        value="$(prop_value "$props" "Evdev Axes Swap" | tr -d '[:space:]')"
        case "$value" in
            0|1) printf '%s\n' "$value"; return 0 ;;
        esac
    fi

    value="$(conf_swap | tr -d '[:space:]')"
    case "$value" in
        0|1) printf '%s\n' "$value" ;;
    esac
    return 0
}

wait_for_apt_lock() {
    local waited=0 locked file

    while [ "$waited" -lt 180 ]; do
        locked=0
        if pgrep -x "apt|apt-get|dpkg|unattended-upgr" >/dev/null 2>&1; then
            locked=1
        else
            for file in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock; do
                if command -v fuser >/dev/null 2>&1 && fuser "$file" >/dev/null 2>&1; then
                    locked=1
                    break
                fi
            done
        fi
        if [ "$locked" -eq 0 ]; then
            return 0
        fi

        if [ "$waited" -eq 0 ]; then
            echo "Waiting for background apt/dpkg processes to finish..."
        fi
        sleep 2
        waited=$((waited + 2))
    done
    return 0
}

ensure_calibrator() {
    local deb="$DEFAULT_DEB"

    if command -v "$CALIBRATOR" >/dev/null 2>&1; then
        return 0
    fi

    echo "xinput_calibrator is not installed; installing it..."
    wait_for_apt_lock
    apt-get -o DPkg::Lock::Timeout=120 install -y xinput-calibrator
    if command -v "$CALIBRATOR" >/dev/null 2>&1; then
        return 0
    fi

    if [ -f "$deb" ]; then
        echo "apt install failed; installing the bundled package $deb"
        wait_for_apt_lock
        dpkg -i -B "$deb"
    else
        warn "bundled package not found: $deb"
    fi

    command -v "$CALIBRATOR" >/dev/null 2>&1
}

# Persist calibration + swap axes, keeping a single .bak of the previous file.
write_conf() {
    local cal="$1"
    local swap="$2"
    local dir

    dir="$(dirname "$CONF")"
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir" || die "cannot create directory $dir"
    fi

    if [ -f "$CONF" ]; then
        cp -f "$CONF" "$CONF.bak" || die "cannot back up $CONF"
    fi

    cat > "$CONF" <<EOF
Section "InputClass"
        Identifier      "calibration"
        MatchProduct    "$DEVICE_NAME"
        Driver          "evdev"
        Option  "Calibration"   "$cal"
        Option  "SwapAxes"      "$swap"
EndSection
EOF
    if [ $? -ne 0 ]; then
        die "cannot write $CONF"
    fi
    chmod 644 "$CONF" 2>/dev/null
}

# Apply calibration live through XInput, without restarting X.
apply_live() {
    local cal="$1"
    local swap="$2"
    local id props a b c d

    if [ "${LCD35_NO_APPLY:-0}" = "1" ]; then
        echo "LCD35_NO_APPLY=1: skipped the live XInput update."
        return 0
    fi

    if ! command -v xinput >/dev/null 2>&1; then
        warn "the 'xinput' tool is not installed; calibration saved to $CONF only (install the 'xinput' package)"
        return 1
    fi

    id="$(device_id)" || {
        warn "'$DEVICE_NAME' not found; calibration saved to $CONF but not applied live"
        return 1
    }
    props="$(as_user xinput list-props "$id" 2>/dev/null)"
    if [ -z "$props" ]; then
        warn "cannot read XInput properties for device $id on $DISPLAY_NUM; calibration saved to $CONF only"
        return 1
    fi

    if ! printf '%s\n' "$props" | grep -qF "Evdev Axis Calibration"; then
        warn "device $id has no 'Evdev Axis Calibration' property (it is handled by libinput)."
        warn "Calibration was saved to $CONF but only takes effect after an X restart or reboot."
        return 1
    fi

    set -- $cal
    a="$1"; b="$2"; c="$3"; d="$4"
    if as_user xinput set-prop "$id" "Evdev Axis Calibration" "$a" "$b" "$c" "$d"; then
        echo "Applied calibration: $a $b $c $d"
    else
        warn "failed to set 'Evdev Axis Calibration'"
        return 1
    fi

    if [ -n "$swap" ]; then
        if as_user xinput set-prop "$id" "Evdev Axes Swap" "$swap"; then
            echo "Applied SwapAxes: $swap"
        else
            warn "failed to set 'Evdev Axes Swap'"
        fi
    fi
    return 0
}

# $1 = calibration, $2 = flip X (0/1), $3 = flip Y (0/1)
flip_calibration() {
    local cal="$1"
    local flip_x="$2"
    local flip_y="$3"
    local a b c d tmp

    set -- $cal
    a="$1"; b="$2"; c="$3"; d="$4"

    if [ "$flip_x" = "1" ]; then
        tmp="$a"; a="$b"; b="$tmp"
    fi
    if [ "$flip_y" = "1" ]; then
        tmp="$c"; c="$d"; d="$tmp"
    fi

    printf '%s %s %s %s\n' "$a" "$b" "$c" "$d"
}

parse_calibrator_calibration() {
    printf '%s\n' "$1" \
        | sed -n 's/.*Option[[:space:]]*"Calibration"[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n1
}

parse_calibrator_swap() {
    printf '%s\n' "$1" \
        | sed -n 's/.*Option[[:space:]]*"SwapAxes"[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n1
}

cmd_wizard() {
    local id output cal swap

    id="$(device_id)" || {
        if ! command -v xinput >/dev/null 2>&1; then
            die "the 'xinput' tool is not installed; install it with 'sudo apt-get install xinput'"
        fi
        die "'$DEVICE_NAME' not found; is the LCD overlay loaded and X running?"
    }
    if ! command -v "$CALIBRATOR" >/dev/null 2>&1; then
        ensure_calibrator || die "xinput_calibrator is not installed and could not be installed"
    fi

    echo "Starting on-screen calibration for device $id..."
    echo "Touch each cross exactly once (press ESC to abort)."
    output="$(as_user "$CALIBRATOR" --device "$id" --output-type xorg.conf.d)"
    if [ -z "$output" ]; then
        die "calibration aborted (no output from $CALIBRATOR)"
    fi

    cal="$(parse_calibrator_calibration "$output")"
    swap="$(parse_calibrator_swap "$output")"
    case "$swap" in
        0|1) ;;
        *) swap="" ;;
    esac
    if [ -z "$swap" ]; then
        swap="$(conf_swap)"
    fi
    if [ -z "$swap" ]; then
        swap="0"
    fi

    if ! valid_calibration "$cal"; then
        echo "Calibrator output was:" >&2
        printf '%s\n' "$output" >&2
        die "could not parse a valid 'Option \"Calibration\"' line from the calibrator output"
    fi

    cal="$(normalize_calibration "$cal")"
    write_conf "$cal" "$swap"
    echo "Saved calibration to $CONF"
    apply_live "$cal" "$swap"
}

cmd_flip() {
    local flip_x="$1"
    local flip_y="$2"
    local old_cal new_cal swap

    old_cal="$(current_calibration)" || \
        die "no usable calibration found (neither the live device nor $CONF); run 'sudo lcd35-calibrate' first"
    old_cal="$(normalize_calibration "$old_cal")"

    swap="$(current_swap)"
    if [ -z "$swap" ]; then
        swap="0"
    fi

    new_cal="$(flip_calibration "$old_cal" "$flip_x" "$flip_y")"

    echo "Old calibration: $old_cal"
    echo "New calibration: $new_cal"
    write_conf "$new_cal" "$swap"
    echo "Saved calibration to $CONF"
    apply_live "$new_cal" "$swap"
}

cmd_reset() {
    local cal swap

    if [ ! -f "$DEFAULT_CONF" ]; then
        die "default calibration file not found: $DEFAULT_CONF"
    fi

    cal="$(conf_calibration "$DEFAULT_CONF")"
    if ! valid_calibration "$cal"; then
        die "$DEFAULT_CONF does not contain a valid 'Option \"Calibration\"'"
    fi
    swap="$(conf_swap "$DEFAULT_CONF")"
    if [ -z "$swap" ]; then
        swap="0"
    fi

    if [ -f "$CONF" ]; then
        cp -f "$CONF" "$CONF.bak" || die "cannot back up $CONF"
    fi
    cp -f "$DEFAULT_CONF" "$CONF" || die "cannot copy $DEFAULT_CONF to $CONF"
    chmod 644 "$CONF" 2>/dev/null
    echo "Restored $CONF from $DEFAULT_CONF"

    cal="$(normalize_calibration "$cal")"
    apply_live "$cal" "$swap"
}

cmd_show() {
    local id name props live_cal live_swap matrix conf_cal conf_swap

    echo "Session user:          $SESSION_USER"
    echo "Display:               $DISPLAY_NUM"
    echo "XAUTHORITY:            $XAUTH"

    props=""
    if id="$(device_id)"; then
        name="$(as_user xinput list --name-only "$id" 2>/dev/null | head -n1)"
        if [ -z "$name" ]; then
            name="$DEVICE_NAME"
        fi
        echo "Device:                $name (id $id)"
        props="$(as_user xinput list-props "$id" 2>/dev/null)"
    else
        echo "Device:                $DEVICE_NAME (not found)"
    fi

    if [ -z "$props" ]; then
        echo "Active driver:         unknown (cannot query XInput)"
        echo "Live calibration:      (unavailable)"
        echo "Live swap axes:        (unavailable)"
        echo "Transformation matrix: (unavailable)"
    else
        if printf '%s\n' "$props" | grep -qF "Evdev Axis Calibration"; then
            echo "Active driver:         evdev"
        else
            echo "Active driver:         libinput"
        fi

        live_cal="$(prop_value "$props" "Evdev Axis Calibration" | tr ',' ' ')"
        if valid_calibration "$live_cal"; then
            echo "Live calibration:      $(normalize_calibration "$live_cal")"
        else
            echo "Live calibration:      (not set)"
        fi

        live_swap="$(prop_value "$props" "Evdev Axes Swap" | tr -d '[:space:]')"
        case "$live_swap" in
            0|1) echo "Live swap axes:        $live_swap" ;;
            *) echo "Live swap axes:        (not available)" ;;
        esac

        matrix="$(prop_value "$props" "Coordinate Transformation Matrix" | tr -d '[:space:]')"
        if [ -n "$matrix" ]; then
            echo "Transformation matrix: $matrix"
        else
            echo "Transformation matrix: (not set)"
        fi
    fi

    echo ""
    echo "Config file:           $CONF"
    if [ -f "$CONF" ]; then
        conf_cal="$(conf_calibration)"
        conf_swap="$(conf_swap)"
        if [ -n "$conf_cal" ]; then
            echo "Config calibration:    $conf_cal"
        else
            echo "Config calibration:    (not set)"
        fi
        if [ -n "$conf_swap" ]; then
            echo "Config SwapAxes:       $conf_swap"
        else
            echo "Config SwapAxes:       (not set)"
        fi
        echo "--- $CONF ---"
        cat "$CONF"
    else
        echo "(file not found)"
    fi
}

restart_x() {
    local profile="$SESSION_HOME/.bash_profile"

    if [ -f "$profile" ] && grep -q "lcd35-restart-x" "$profile"; then
        touch "$RESTART_FLAG" && chmod 666 "$RESTART_FLAG"
        echo "Restarting the X server..."
        pkill -TERM -x Xorg
        return 0
    fi

    echo "reboot required: $profile has no lcd35-restart-x hook to restart X automatically."
    return 0
}

ACTION=""
RESTART_X=0

for arg in "$@"; do
    case "$arg" in
        --wizard|--calibrate) set_action wizard ;;
        --flip-x) set_action flip-x ;;
        --flip-y) set_action flip-y ;;
        --flip-both) set_action flip-both ;;
        --show|--status) set_action show ;;
        --reset) set_action reset ;;
        --restart-x) RESTART_X=1 ;;
        --help|-h) usage; exit 0 ;;
        *)
            echo "lcd35-calibrate: unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [ -z "$ACTION" ] && [ "$RESTART_X" -eq 0 ]; then
    ACTION="wizard"
fi

if [ "$ACTION" != "show" ] && [ "$(id -u)" -ne 0 ] && [ "${LCD35_NO_APPLY:-0}" != "1" ]; then
    die "must be run as root: sudo lcd35-calibrate"
fi

resolve_session_user
resolve_home
resolve_display

case "$ACTION" in
    wizard) cmd_wizard ;;
    flip-x) cmd_flip 1 0 ;;
    flip-y) cmd_flip 0 1 ;;
    flip-both) cmd_flip 1 1 ;;
    show) cmd_show ;;
    reset) cmd_reset ;;
esac

if [ "$RESTART_X" -eq 1 ]; then
    restart_x
fi

exit 0
