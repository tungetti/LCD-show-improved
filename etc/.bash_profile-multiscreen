if [ -f "$HOME/.profile" ]; then
    . "$HOME/.profile"
fi

if [ -z "${SSH_CONNECTION:-}" ] && [ -z "${DISPLAY:-}" ] && [ "$(tty 2>/dev/null)" = "/dev/tty1" ]; then
    while true; do
        sudo rm -f /run/lcd35-restart-x 2>/dev/null || rm -f /run/lcd35-restart-x 2>/dev/null || true
        if [ -x /usr/local/bin/lcd35-apply-xorg-mode.sh ]; then
            sudo /usr/local/bin/lcd35-apply-xorg-mode.sh --no-restart
        fi
        unset FRAMEBUFFER
        startx 2> "$HOME/.xorg-lcd.log"
        if [ ! -f /run/lcd35-restart-x ]; then
            break
        fi
        sleep 1
    done
fi
